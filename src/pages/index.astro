---
import Layout from '../layouts/Layout.astro';

const repo = 'https://github.com/declarative-migrations/declarative-postgres-migrate.rs';

const cards = [
  {
    title: 'Any source, any target',
    body: 'Live database ↔ catalog.json dump ↔ schema.sql (or a pg_dump -s dump, materialized on a shadow server). All nine pairings produce byte-identical migrations — asserted in CI.',
  },
  {
    title: 'Convergence, proven',
    body: 'dpm verify replays your target onto a throwaway replica, applies the migration, re-introspects, re-diffs. An empty plan is the proof. Exit codes made for CI.',
  },
  {
    title: 'Destructive = two consents',
    body: '--allow-destructive-sql to generate drops (otherwise commented out), --allow-destructive-ops to execute them. Apply fails closed.',
  },
  {
    title: 'Supabase-aware',
    body: 'Managed schemas excluded by default, RLS + policies are first-class diffed objects, transaction-pooler connections detected and refused with a fix hint.',
  },
];

const tools = ['migra', 'pgdiff', 'atlas', 'stripe/pg-schema-diff', 'liquibase', 'apgdiff', 'flyway'];

const orms = [
  ['Drizzle', 'drizzle-kit export → schema.sql'],
  ['Prisma', 'prisma migrate diff --from-empty --to-schema-datamodel --script'],
  ['SeaORM / sqlx / ent / Django / Rails', 'migrations → scratch db → --source postgres://scratch'],
  ['Raw SQL', 'the file is the source'],
];

const steps = [
  'Everything is reviewable SQL — dpm never executes without explicit consent.',
  'Constraint adds on existing tables use NOT VALID + VALIDATE; enum values are added outside the transaction; FKs land last.',
  'Manual-review items (enum label removal, partition-strategy changes) are surfaced as comments, never guessed at.',
];
---
<Layout
  title="declarative-migrations — dpm"
  description="dpm: declarative, ORM-agnostic Postgres schema migration. Diff two databases, get reviewable SQL, prove convergence, countersign with seven independent tools."
>
  <header>
    <div class="kicker">declarative-migrations / dpm</div>
    <h1>The database is the schema. <em>Diff it like one.</em></h1>
    <p class="sub">
      dpm is declarative, ORM-agnostic Postgres schema migration in Rust: introspect two states,
      diff the catalogs, emit reviewable SQL that converges one onto the other — then
      <strong>prove</strong> it converged, and let seven independent tools countersign the proof.
    </p>
    <div class="cta">
      <a class="btn btn-primary" href={repo}>GitHub →</a>
      <a class="btn btn-ghost" href={`${repo}/releases`}>Releases</a>
      <a class="btn btn-ghost" href={`${repo}/blob/main/docs/beyond-just-schema-migrations.md`}>Data-migrations design</a>
    </div>
  </header>

  <section>
    <h2>Install</h2>
    <pre><span class="c"># curl — prebuilt binary from the latest release (cargo fallback)</span>
curl -fsSL https://raw.githubusercontent.com/declarative-migrations/declarative-postgres-migrate.rs/main/scripts/install.sh | bash

<span class="c"># Homebrew</span>
brew install declarative-migrations/tap/dpm

<span class="c"># From source</span>
cargo install --git {repo}</pre>
  </section>

  <section>
    <h2>One idea, taken seriously</h2>
    <p class="lede">
      The Postgres system catalogs are the neutral interchange format. Whether a schema was authored
      by Prisma, Drizzle, SeaORM, ent, peewee, or raw SQL — once it exists,
      <code class="inline">pg_catalog</code> describes it canonically. dpm deparses both sides
      <em>with the server itself</em> (<code class="inline">pg_get_constraintdef</code>,
      <code class="inline">pg_get_indexdef</code>, <code class="inline">format_type</code>, … under
      <code class="inline">search_path = ''</code>), so comparison is exact string equality.
      No regex reconciliation of hand-written SQL against Postgres' re-serialized forms.
    </p>
    <pre><span class="k">dpm diff</span>   --source postgres://…/desired  --target postgres://…/live
<span class="k">dpm verify</span> --source schema.sql --target "$DATABASE_URL" --shadow "$SHADOW_DATABASE_URL" --cross-check-all
<span class="k">dpm apply</span>  --yes   <span class="c"># interactive confirm without --yes; destructive ops need explicit consent</span></pre>
    <div class="grid">
      {cards.map((c) => (
        <div class="card">
          <h3>{c.title}</h3>
          <p>{c.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section>
    <h2>Seven tools countersign every migration</h2>
    <p class="lede">
      dpm never asks you to take its word for it. Six independent diff engines must see
      <em>zero remaining difference</em> after dpm migrates; flyway validates the script under a
      standard migration runner. The test matrix runs all of them against ten schema fixtures — and
      it has already caught real bugs (that's the point).
    </p>
    <div class="tools">
      {tools.map((t) => <span class="tool"><b>✓</b> {t}</span>)}
    </div>
    <pre>dpm verify … <span class="k">--cross-check-all</span>            <span class="c"># every installed tool</span>
dpm verify … <span class="k">--cross-check-with-migra --cross-check-with-atlas</span>
dpm verify … <span class="k">--cross-check-with-ai</span>        <span class="c"># AI discrepancy scan over all reports</span></pre>
    <p class="note">
      The AI layer reviews migrations too — <code class="inline">dpm review</code> drives the
      Anthropic / OpenAI / Gemini HTTP APIs (or the claude / codex / gemini CLIs) with a fail-closed
      machine verdict: no parseable <code class="inline">DPM_VERDICT</code>, no approval.
    </p>
  </section>

  <section>
    <h2>ORM-agnostic by construction</h2>
    <div class="tblwrap">
      <table>
        <tr><th>You use</th><th>dpm source</th></tr>
        {orms.map(([orm, how]) => (
          <tr><td>{orm}</td><td><code>{how}</code></td></tr>
        ))}
      </table>
    </div>
    <p class="note">
      “Diff my Drizzle app against the SeaORM service's database” is one command. dpm never parses ORM code.
    </p>
  </section>

  <section>
    <h2>How verify works</h2>
    <div class="flow">{`target db ──introspect──▶ catalog ──bootstrap──▶ throwaway replica
                                              │ fidelity check (dpm refuses on its own coverage gaps)
source ───introspect──▶ catalog ──diff──▶ migration SQL ──apply──▶ replica
                                              │
                            re-introspect ──re-diff──▶ empty plan = proof
                                              │
              migra · pgdiff · atlas · pg-schema-diff · liquibase · apgdiff · flyway
                                              │
                                   AI discrepancy scan (optional)`}</div>
    <ol class="steps">
      {steps.map((s, i) => (
        <li><span class="num">{String(i + 1).padStart(2, '0')}</span>{s}</li>
      ))}
    </ol>
  </section>

  <footer>
    <p>
      MIT © Alex Mills ·
      <a href="https://github.com/declarative-migrations"> github.com/declarative-migrations</a> ·
      schema migrations today,
      <a href={`${repo}/blob/main/docs/beyond-just-schema-migrations.md`}> data migrations next</a>.
      Built with Astro.
    </p>
  </footer>
</Layout>

<style>
header{padding:72px 0 48px;border-bottom:1px solid var(--line)}
.kicker{font-family:var(--mono);font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);margin-bottom:18px}
h1{font-size:clamp(30px,5vw,46px);font-weight:600;line-height:1.15;letter-spacing:-.01em;max-width:21ch}
h1 em{font-style:italic;color:var(--accent)}
.sub{margin-top:18px;font-size:19px;color:var(--muted);max-width:60ch}
.cta{margin-top:28px;display:flex;gap:12px;flex-wrap:wrap}
.btn{display:inline-block;padding:10px 18px;border-radius:8px;text-decoration:none;font-family:var(--mono);font-size:14px}
.btn-primary{background:var(--accent);color:#fff}
.btn-ghost{border:1px solid var(--line);color:var(--fg)}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px;margin-top:8px}
.card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:20px 22px}
.card h3{font-size:16.5px;margin-bottom:8px;font-weight:600}
.card p{font-size:14.5px;color:var(--muted)}
.tools{display:flex;flex-wrap:wrap;gap:10px;margin:20px 0 18px}
.tool{font-family:var(--mono);font-size:13px;border:1px solid var(--line);background:var(--card);border-radius:999px;padding:6px 14px}
.tool b{color:var(--ok);font-weight:600}
.note{margin-top:14px;color:var(--muted);font-size:14.5px}
.tblwrap{overflow-x:auto}
table{width:100%;border-collapse:collapse;font-size:14.5px;margin-top:14px}
th,td{text-align:left;padding:9px 12px;border-bottom:1px solid var(--line);vertical-align:top}
th{font-family:var(--mono);font-size:12px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted)}
td code{font-family:var(--mono);font-size:12.5px}
.flow{font-family:var(--mono);font-size:13px;background:var(--card);border:1px solid var(--line);border-radius:12px;padding:18px 22px;overflow-x:auto;white-space:pre;line-height:1.9}
ol.steps{list-style:none;margin-top:22px}
ol.steps li{padding:10px 0;border-bottom:1px dashed var(--line);font-size:15.5px}
ol.steps li:last-child{border-bottom:none}
.num{font-family:var(--mono);color:var(--accent);font-size:13px;margin-right:6px}
footer{padding:44px 0 64px;color:var(--muted);font-size:14px}
</style>
