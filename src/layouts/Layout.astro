---
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;

// Canonical URL from the configured `site` + current path.
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://declarative-migrations.github.io').href;

// Content-Security-Policy for a fully static, no-client-JS page. GitHub Pages
// cannot set response headers, so this is delivered as a meta tag: the
// document-level directives below are enforced; `frame-ancestors` /
// `upgrade-insecure-requests` are header-only and intentionally omitted.
// The page ships inline <style> blocks and a data: SVG favicon, hence
// 'unsafe-inline' for style and data: for img — no inline or remote script is
// allowed.
const csp = [
  "default-src 'self'",
  "script-src 'self'",
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data:",
  "font-src 'self'",
  "connect-src 'self'",
  "base-uri 'self'",
  "form-action 'self'",
  "object-src 'none'",
].join('; ');
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta http-equiv="Content-Security-Policy" content={csp} />
  <meta name="color-scheme" content="light dark" />
  <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#101318" media="(prefers-color-scheme: dark)" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>⇄</text></svg>" />
</head>
<body>
  <a class="skip-link" href="#content">Skip to content</a>
  <header class="site-nav">
    <div class="nav-inner">
      <a class="nav-brand" href="/" aria-label="Declarative Migrations home"><span>⇄</span><strong>Declarative Migrations</strong></a>
      <nav class="desktop-nav" aria-label="Primary navigation">
        <a href="/#install">Install</a>
        <a href="/#proof">Proof</a>
        <a href="/#integrations">Integrations</a>
        <a href="https://github.com/declarative-migrations">Source</a>
      </nav>
      <div class="account-nav"><a href="https://user.declarative-migrations.github.io/">Log in</a><a class="signup" href="https://auth.declarative-migrations.github.io/">Sign up</a></div>
      <details class="mobile-nav"><summary>Menu</summary><nav aria-label="Mobile navigation"><a href="/#install">Install</a><a href="/#proof">Proof</a><a href="/#integrations">Integrations</a><a href="https://github.com/declarative-migrations">Source</a><a href="https://user.declarative-migrations.github.io/">Log in</a><a class="signup" href="https://auth.declarative-migrations.github.io/">Sign up</a></nav></details>
    </div>
  </header>
  <div class="wrap" id="content">
    <slot />
  </div>
</body>
</html>

<style is:global>
:root{
  --bg:#fbfaf7; --fg:#1a1d21; --muted:#5c6470; --line:#e4e1d8;
  --card:#ffffff; --accent:#b4552d; --accent-soft:#f4e5dc;
  --code-bg:#14171c; --code-fg:#e7e4dc; --ok:#2b7a4b;
  --mono:ui-monospace,'SF Mono',SFMono-Regular,Menlo,Consolas,monospace;
}
@media (prefers-color-scheme: dark){
  :root{
    --bg:#101318; --fg:#e8e6e1; --muted:#9aa3ae; --line:#262b33;
    --card:#171c23; --accent:#e08150; --accent-soft:#2a2019;
    --code-bg:#0b0d11; --code-fg:#dcd9d1; --ok:#5cbf85;
  }
}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:var(--fg);font:16px/1.65 Georgia,'Times New Roman',serif;-webkit-font-smoothing:antialiased}
.wrap{max-width:960px;margin:0 auto;padding:0 24px}
a{color:var(--accent)}
.skip-link{position:fixed;left:16px;top:12px;z-index:1000;transform:translateY(-180%);padding:8px 12px;border-radius:999px;background:var(--fg);color:var(--bg);font-family:var(--mono);font-size:13px;text-decoration:none}.skip-link:focus{transform:none}
.site-nav{position:sticky;top:0;z-index:100;padding:11px 0;border-bottom:1px solid var(--line);background:color-mix(in srgb,var(--bg) 90%,transparent);backdrop-filter:blur(16px)}
.nav-inner{display:flex;align-items:center;gap:22px;max-width:1100px;margin:0 auto;padding:0 24px}
.nav-brand{display:flex;align-items:center;gap:9px;margin-right:auto;color:var(--fg);font-family:var(--mono);font-size:13px;text-decoration:none}.nav-brand span{display:grid;width:30px;height:30px;place-items:center;border-radius:8px;background:var(--fg);color:var(--bg);font-size:17px}.nav-brand strong{font-weight:700}
.desktop-nav,.account-nav{display:flex;align-items:center;gap:18px}.desktop-nav a,.account-nav>a:first-child{color:var(--fg);font-family:var(--mono);font-size:12px;text-decoration:none}.desktop-nav a:hover,.account-nav>a:first-child:hover{text-decoration:underline;text-underline-offset:4px}
.signup{display:inline-block;padding:7px 12px;border-radius:8px;background:var(--accent);color:white;font-family:var(--mono);font-size:12px;text-decoration:none}.mobile-nav{display:none}
h2{font-size:24px;font-weight:600;margin-bottom:8px}
section{padding:52px 0;border-bottom:1px solid var(--line)}
.lede{color:var(--muted);margin-bottom:26px;max-width:64ch}
pre{background:var(--code-bg);color:var(--code-fg);border-radius:10px;padding:18px 20px;overflow-x:auto;font-family:var(--mono);font-size:13.5px;line-height:1.7}
pre .c{color:#7d8590}
pre .k{color:#e5a458}
code.inline{font-family:var(--mono);font-size:.88em;background:var(--accent-soft);color:var(--accent);padding:1px 6px;border-radius:5px}
@media(max-width:780px){.desktop-nav,.account-nav{display:none}.mobile-nav{display:block}.mobile-nav summary{padding:7px 12px;border:1px solid var(--line);border-radius:8px;font-family:var(--mono);font-size:12px;list-style:none;cursor:pointer}.mobile-nav[open] nav{position:absolute;top:calc(100% + 6px);right:16px;left:16px;display:grid;gap:5px;padding:12px;border:1px solid var(--line);border-radius:10px;background:var(--fg);box-shadow:0 24px 60px #0005}.mobile-nav nav a{padding:9px;color:var(--bg);font-family:var(--mono);font-size:13px;text-decoration:none}.mobile-nav nav .signup{background:var(--accent);color:white;text-align:center}}
</style>
